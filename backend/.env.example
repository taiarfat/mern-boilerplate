# Server Configuration
PORT=5000

# MongoDB Configuration
MONGO_URI=mongodb://localhost:27017/executive-dashboard

# Security Configuration
SALT_ROUND=10

# Rate Limiting Configuration (in minutes)
RATE_LIMIT_TIME=15
RATE_LIMIT_REQUEST=100

# JWT Configuration
ACCESS_TOKEN_SECRET=your_access_token_secret
ACCESS_TOKEN_EXPIRES=15m
ACCESS_TOKEN_COOKIE_EXPIRE_TIME=15

REFRESH_TOKEN_SECRET=your_refresh_token_secret
REFRESH_TOKEN_EXPIRES=7d
REFRESH_TOKEN_COOKIE_EXPIRE_TIME=10080

# Database Token Expiration (in minutes)
DB_TOKEN_EXPIRES=10080

AI_MODEL=gemma3:4b 

AI_ENDPOINT=http://localhost:11434/api/generate